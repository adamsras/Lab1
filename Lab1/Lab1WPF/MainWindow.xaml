<Window x:Class="Lab1WPF.MainWindow" x:Name="Students"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Studenti" Height="620" Width="760" MinHeight="540" MinWidth="700" WindowStartupLocation="CenterScreen">
 <Grid Margin="20" Background="White">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid HorizontalAlignment="Left">
   <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="44"/></Grid.RowDefinitions>
   <Label x:Name="lblName" Content="Vārds:" Target="{Binding ElementName=txtName}"/>
   <TextBox x:Name="txtName" Grid.Column="1" Margin="0,4" VerticalContentAlignment="Center"/>
   <Label x:Name="lblSurname" Grid.Row="1" Content="Uzvārds:" Target="{Binding ElementName=txtSurname}"/>
   <TextBox x:Name="txtSurname" Grid.Row="1" Grid.Column="1" Margin="0,4" VerticalContentAlignment="Center"/>
   <Label x:Name="lblId" Grid.Row="2" Content="Apl.Nr.:" Target="{Binding ElementName=txtId}"/>
   <TextBox x:Name="txtId" Grid.Row="2" Grid.Column="1" Margin="0,4" VerticalContentAlignment="Center"/>
   <Label x:Name="lblGroup" Grid.Row="3" Content="Grupa:" Target="{Binding ElementName=txtGroup}"/>
   <TextBox x:Name="txtGroup" Grid.Row="3" Grid.Column="1" Margin="0,4" VerticalContentAlignment="Center"/>
   <Label x:Name="lblEmail" Grid.Row="4" Content="E-pasts:" Target="{Binding ElementName=txtEmail}"/>
   <TextBox x:Name="txtEmail" Grid.Row="4" Grid.Column="1" Margin="0,4" VerticalContentAlignment="Center"/>
   <Button x:Name="btnAddStudent" Grid.Row="5" Grid.Column="1" Content="Pievienot sarakstam" Width="138" Height="30" HorizontalAlignment="Right" Click="btnAddStudent_Click"/>
  </Grid>
  <Label x:Name="lblStudentList" Grid.Row="1" Content="Studentu saraksts:" Margin="0,10,0,4"/>
  <ListView x:Name="lstStudents" Grid.Row="2">
   <ListView.View><GridView>
    <GridViewColumn Header="Vārds" DisplayMemberBinding="{Binding Name}" Width="110"/>
    <GridViewColumn Header="Uzvārds" DisplayMemberBinding="{Binding Surname}" Width="130"/>
    <GridViewColumn Header="Apl.Nr." DisplayMemberBinding="{Binding Id}" Width="100"/>
    <GridViewColumn Header="Grupa" DisplayMemberBinding="{Binding Group}" Width="90"/>
    <GridViewColumn Header="E-pasts" DisplayMemberBinding="{Binding Email}" Width="225"/>
   </GridView></ListView.View>
  </ListView>
  <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
   <Button x:Name="btnSave" Content="Saglabāt" Width="90" Height="30" Click="btnSave_Click"/>
   <Button x:Name="btnLoad" Content="Ielādēt" Width="90" Height="30" Margin="10,0,0,0" Click="btnLoad_Click"/>
  </StackPanel>
 </Grid>
</Window>